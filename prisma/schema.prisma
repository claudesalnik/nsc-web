// Prisma schema for Newcastle Sunday Club vehicle storage platform
// Database: PostgreSQL (Vercel Postgres compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessStatus {
  IN
  OUT
  MAINTENANCE
}

enum AccessEventType {
  IN
  OUT
  VISIT
}

enum MembershipTier {
  FOUNDER
  PREMIUM
  STANDARD
}

enum OwnerStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum VehiclePhotoType {
  INTAKE
  CURRENT
  DAMAGE
}

model Owner {
  id             String         @id @default(cuid())
  fullName       String
  email          String         @unique
  phone          String?        @db.VarChar(32)
  city           String?
  company        String?
  membershipTag  String?        @db.VarChar(64)
  membershipTier MembershipTier @default(PREMIUM)
  status         OwnerStatus    @default(ACTIVE)
  notes          String?
  joinedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vehicles          Vehicle[]
  conciergeRequests ConciergeRequest[]
  accessLogs        AccessLog[]

  @@index([fullName])
  @@index([membershipTier])
  @@index([status])
}

model Vehicle {
  id            String       @id @default(cuid())
  ownerId       String
  vin           String?      @unique @db.VarChar(32)
  year          Int
  make          String
  model         String
  trim          String?
  color         String?
  licensePlate  String?      @db.VarChar(16)
  plateState    String?      @db.VarChar(16)
  status        AccessStatus @default(IN)
  storageSpotId String?      @unique
  acquiredAt    DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  owner             Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageSpot       StorageSpot?         @relation("StorageSpotVehicle", fields: [storageSpotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  photos            VehiclePhoto[]
  statusEvents      VehicleStatusEvent[]
  conciergeRequests ConciergeRequest[]
  accessLogs        AccessLog[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([make, model])
  @@index([status])
  @@index([licensePlate])
}

model StorageSpot {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  size        String? // e.g. "Standard", "Oversize"
  level       String? // e.g. "Main Floor", "Basement"
  climate     String? // e.g. "Standard", "Climate"
  zone        String?  @db.VarChar(32)
  section     String?  @db.VarChar(32)
  rowLabel    String?  @db.VarChar(32)
  isTransient Boolean  @default(false)
  isOccupied  Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle      Vehicle?             @relation("StorageSpotVehicle")
  statusEvents VehicleStatusEvent[]

  @@index([zone])
  @@index([section])
  @@index([isOccupied])
}

model VehiclePhoto {
  id         String           @id @default(cuid())
  vehicleId  String
  url        String
  storageKey String           @unique
  filename   String
  mimeType   String
  size       Int              @default(0)
  caption    String?
  type       VehiclePhotoType @default(CURRENT)
  takenAt    DateTime?        @default(now())
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
}

model VehicleStatusEvent {
  id            String       @id @default(cuid())
  vehicleId     String
  storageSpotId String?
  status        AccessStatus
  occurredAt    DateTime     @default(now())
  note          String?
  recordedBy    String? // staff initials or user id

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  storageSpot StorageSpot? @relation(fields: [storageSpotId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([vehicleId, occurredAt])
  @@index([storageSpotId])
  @@index([status, occurredAt])
}

model AccessLog {
  id        String          @id @default(cuid())
  memberId  String
  vehicleId String?
  eventType AccessEventType
  timestamp DateTime        @default(now())
  notes     String?
  createdAt DateTime        @default(now())

  member  Owner    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([memberId, timestamp])
  @@index([vehicleId, timestamp])
  @@index([eventType, timestamp])
}

// ─── Concierge Requests ────────────────────────────────────────────────────

enum ConciergeRequestType {
  DETAILING
  BATTERY_RUN
  OTHER
}

enum ConciergeRequestStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  DONE
}

model ConciergeRequest {
  id            String                 @id @default(cuid())
  memberId      String // Owner.id
  vehicleId     String? // optional: which vehicle
  type          ConciergeRequestType
  notes         String?
  requestedDate DateTime?
  status        ConciergeRequestStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  member  Owner    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([status])
  @@index([status, requestedDate])
}
